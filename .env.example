# Resend API-kulcs az űrlapok e-mail-küldéséhez.
RESEND_API_KEY=
# Az űrlap-értesítések címzettje (e-mail-cím).
CONTACT_TO_EMAIL=
# A feladó e-mail-címe, megjelenítendő név nélkül; a Resendben hitelesített domainről.
CONTACT_FROM_EMAIL=
# Az n8n webhook URL-je a kapcsolatfelvételi űrlaphoz; üresen az n8n-hívás kimarad.
N8N_CONTACT_WEBHOOK_URL=
# Az n8n webhook URL-je a pilot-jelentkezéshez; üresen az n8n-hívás kimarad.
N8N_PILOT_WEBHOOK_URL=
# A GTM-tároló azonosítója. Csak éles buildnél, build-argumentumként. Helyben üresen hagyni.
NEXT_PUBLIC_GTM_ID=
